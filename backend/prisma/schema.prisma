generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  surname   String
  email     String     @unique
  password  String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  role      Role       @default(STUDENT)
}
